{
  "name": "ProducerProfile",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fayda_id_image_url": {
      "type": "string"
    },
    "tax_receipt_image_url": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "company_name",
    "owner_name"
  ]
}